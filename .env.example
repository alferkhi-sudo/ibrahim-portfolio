# ─── Week Planner ────────────────────────────────────────────────────────────
# Password for the /weekplan page. Set this in .env.local (never commit the real value).
WEEKPLAN_PASSWORD="your-secret-password-here"  # quote the value if it contains # or special chars

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Other ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SURVEY_ADMIN_PASSWORD=
